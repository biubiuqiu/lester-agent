POSTGRES_USER=lester
# Required. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=lester
# Required. Generate with: openssl rand -base64 32
MASTER_KEY_BASE64=
# Required. Generate with: openssl rand -hex 32
SANDBOX_SERVICE_TOKEN=
# The app gateway and the separate artifact host are published. Change BOTH values when changing the port/host.
GATEWAY_PORT=13000
WEB_ORIGIN=http://localhost:13000
SESSION_COOKIE_SECURE=false
# Set true for HTTPS. OAuth requires HTTPS except on localhost.
# Close self-registration without disabling existing-account login or linking.
AUTH_REGISTRATION_ENABLED=true
# Exact trusted gateway/Ingress CIDRs, comma-separated. Empty ignores forwarding headers.
# Obtain your gateway IP/subnet from docker network inspect; never use 0.0.0.0/0.
AUTH_TRUSTED_PROXY_CIDRS=
# Optional. Configure ID and secret together; empty pairs hide the login option.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional. When configured, new email accounts must verify and password reset
# becomes available. Without SMTP, existing self-hosted email login remains.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
# Compose builds this runtime image; override only for an intentional custom image.
SANDBOX_IMAGE=lester-sandbox-runtime:local
MINIO_ROOT_USER=lester
# Required. Generate with: openssl rand -hex 24
MINIO_ROOT_PASSWORD=
OBJECT_STORE_BUCKET=lester-skills

# Must use a different hostname from WEB_ORIGIN. Set a public origin for external sharing.
ARTIFACT_PORT=13181
ARTIFACT_PUBLIC_URL=http://127.0.0.1:13181
