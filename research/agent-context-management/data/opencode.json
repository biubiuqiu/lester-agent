{
  "id": "opencode",
  "name": "OpenCode",
  "commit": "f7d5b6ffc48223e654b20043a500d315e4bc8053",
  "repository": "anomalyco/opencode",
  "overview": "持久事件与DB投影驱动、instruction epoch与活动checkpoint双时钟、usage anchor+delta估算、summary/native双路径；入口工具/图片边界先控制体积，超限时有界压缩请求退阶。",
  "layers": [
    {
      "name": "权限允许的能力与稳定指令 baseline",
      "source": "agent system + Instructions sources + tool snapshot",
      "lifecycle": "每步选择，hash blobs建立epoch；更改变durable delta，压缩Ended推进epoch",
      "budget": "计入请求；目录与schema无单独总量hard cap；稳定排序服务cache"
    },
    {
      "name": "语义压缩checkpoint",
      "source": "completed summary或native.messages",
      "lifecycle": "最近可重放checkpoint作为active history边界；原DB记录保留",
      "budget": "summary输出按window room适配；provider native本地不能精确定价"
    },
    {
      "name": "近期精确/近似工作集",
      "source": "keepID引用序列化recent + checkpoint后的新user/assistant/tool",
      "lifecycle": "summary recent为文本重建；未压缩新消息仍canonical结构",
      "budget": "默认keep15000但对齐会超；工具recent限1250codepoints"
    },
    {
      "name": "外置完整工具结果",
      "source": "tool-output/文件",
      "lifecycle": "入口超2000行/50KiB保存全量，7天retention",
      "budget": "文件不全量注入，提示outputPath按需read"
    },
    {
      "name": "provider prompt cache/transport affinity",
      "source": "promptCacheKey、稳定prefix、nativeprovider metadata",
      "lifecycle": "跨请求复用；模型绑定原生proof受exact model约束",
      "budget": "cached input仍计窗口；复用不是压缩"
    }
  ],
