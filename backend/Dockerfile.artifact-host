FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/lester-artifact-host ./cmd/artifact-host
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/lester-artifact-host /lester-artifact-host
USER nonroot:nonroot
ENTRYPOINT ["/lester-artifact-host"]
