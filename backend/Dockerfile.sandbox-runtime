FROM golang:1.25-alpine AS toolbox-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/lester-toolbox ./cmd/lester-toolbox
COPY internal/toolboxfs ./internal/toolboxfs
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/lester-toolbox ./cmd/lester-toolbox

FROM python:3.12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates curl git jq nodejs npm procps ripgrep \
    && groupadd --system sandbox \
    && useradd --system --gid sandbox --create-home --home-dir /home/sandbox --shell /bin/bash sandbox \
    && mkdir -p /workspace \
    && chown sandbox:sandbox /workspace \
    && rm -rf /var/lib/apt/lists/*
COPY --from=toolbox-build /out/lester-toolbox /usr/local/bin/lester-toolbox
USER sandbox
WORKDIR /workspace
CMD ["sleep", "infinity"]
