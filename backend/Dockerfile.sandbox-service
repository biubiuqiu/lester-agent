FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/sandbox-service ./cmd/sandbox-service && \
    CGO_ENABLED=0 go build -o /out/lester-toolbox ./cmd/lester-toolbox
FROM alpine:3.22
RUN apk add --no-cache docker-cli
COPY --from=build /out/sandbox-service /sandbox-service
COPY --from=build /out/lester-toolbox /usr/local/libexec/lester-toolbox
ENTRYPOINT ["/sandbox-service"]
